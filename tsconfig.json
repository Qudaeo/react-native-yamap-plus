{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "react-native-yamap-plus": ["./src/index"]
    },
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "jsx": "react-jsx",
    "lib": ["esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "outDir": "lib",
    "skipLibCheck": true,
    "strict": true,
    "verbatimModuleSyntax": true
  },
  "exclude": ["example", "lib", "**/node_modules", "**/Pods"],
  "include": ["**/*.ts", "**/*.tsx"]
}
